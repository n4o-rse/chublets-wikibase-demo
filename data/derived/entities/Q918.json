  "descriptions": {
    "en": {
      "language": "en",
      "value": "This is an r package for the extraction, analysis and classification of (not only) archaeological objects derived from scanned images. Especially it aims at the analysis of the shapes/profiles of eg. ceramic vessels or arrow heads."
    }
