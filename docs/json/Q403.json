  "descriptions": {
    "en": {
      "language": "en",
      "value": "A simulation tool to estimate the rate of success that surveys possessing user-specific characteristics have in identifying archaeological sites (or any groups of clouds of objects), given specific parameters of survey area, survey methods, and site properties."
    }
