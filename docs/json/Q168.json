  "descriptions": {
    "en": {
      "language": "en",
      "value": "Experimental mobile app demoing cultural heritage documentation tools in augmented reality. Supports capturing and annotating photos in 3d space. Proof-of-concept features in the app include image anchoring and surface drawing tools."
