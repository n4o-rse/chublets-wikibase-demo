data:Q647
    a schema:Dataset,
        dcat:Dataset ;
    cc:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "Excel file containing macro commands making it possible to transform a 1/0 table (presence / absence) into a graphic matrix treated by matrix permutations; it is possible to take into account the uncertain presence of a character. The instructions for use are contained in the file."@en ;
