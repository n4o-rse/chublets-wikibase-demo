    a schema:Dataset,
        dcat:Dataset ;
    cc:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "Ark (the archaeological recording kit) 2.0 development repository. Ark (the archaeological recording kit) is a web-based 'toolkit' for the collection, storage and dissemination of archaeological data. It includes data-editing, data-creation, data-viewing and data-sharing tools, all of which are delivered using a web-based front-end."@en ;
