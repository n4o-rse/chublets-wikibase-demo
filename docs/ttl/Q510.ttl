        dcat:Dataset ;
    cc:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "The nimbleCarbon package provides utility functions and bespoke probability distributions for the Bayesian analyses of radiocarbon dates using the NIMBLE framework. The package is particularly dedicated to demographic inferences based on changing frequencies of radiocarbon dates."@en ;
