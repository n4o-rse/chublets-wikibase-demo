    a schema:Dataset,
        dcat:Dataset ;
    cc:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:description "Sdsbrowser is an r shiny webapp developed to make the available sds datasets (following the systematic and digital documentation of stone artefacts recording system) more accessible. It is designed to give you a quick overview on the spatial and temporal scope of sites previously analysed with sds and the distribution of artefacts within these sites."@en ;
