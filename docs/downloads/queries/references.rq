PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT ?itemLabel ?propertyLabel ?sourceLabel ?source WHERE {
  # Two groups, not three. rdflib joins a group lazily (one solution at a time) only when it has no further
  # join inside it; each additional group is evaluated alone and then paired with every row of the others.
  # The first group finds the statements and their references; the second looks the two properties up
  # for the bound ?claim and ?referenceProperty.
  { ?item ?claim ?statement .
    ?statement prov:wasDerivedFrom ?reference .
    ?reference ?referenceProperty ?source . }
  { ?property wikibase:claim ?claim ;
              rdfs:label ?propertyLabel .
    ?sourceProperty wikibase:reference ?referenceProperty ;
                    rdfs:label ?sourceLabel .
    FILTER(LANG(?propertyLabel) = "en")
    FILTER(LANG(?sourceLabel) = "en") }
  OPTIONAL {
    ?item rdfs:label ?itemLabel .
    FILTER(LANG(?itemLabel) = "en")
  }
}
ORDER BY ?itemLabel ?propertyLabel ?sourceLabel ?source
LIMIT 200
