cat:wikibase-ontology
    a dcat:Dataset ;
    dcterms:isPartOf <https://n4o-rse.github.io/chublets-wikibase-demo/catalog> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:source <http://wikiba.se/ontology> ;
    dcterms:title "The Wikibase system ontology"@en ;
    dcat:distribution dist:wikibase-ontology .

<https://n4o-rse.github.io/chublets-wikibase-demo/catalog>
    a dcat:Catalog ;
    dcterms:conformsTo <http://wikiba.se/ontology> ;
    dcterms:description "The data model of the chublets.software Wikibase, kept as CSV and rendered as a static, read-only copy. Properties, classes and their Wikidata twins, and about 100 software entries imported from open-archaeo." ;
    dcterms:hasPart cat:items,
        cat:properties ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:title "chublets.software Wikibase (model demo)" ;
    dcat:dataset cat:export,
        cat:wikibase-ontology ;
    dcat:landingPage <https://n4o-rse.github.io/chublets-wikibase-demo/> .

